# Kalshi API credentials.
# Create an API key in your Kalshi account settings; you receive a key ID (UUID)
# and download an RSA private key (PEM). Keep the private key out of git.

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# "demo" (https://demo-api.kalshi.co) or "prod" (https://api.elections.kalshi.com)
KALSHI_ENV=demo

# Trading mode safety. Live trading additionally requires --live on the CLI.
MAX_POSITION_USD=50
MAX_DAILY_LOSS_USD=100
